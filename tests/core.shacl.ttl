@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix core: <https://w3id.org/agent-ontology/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix epplan: <https://w3id.org/ep-plan#> .

core:AgentShape
    a sh:NodeShape ;
    sh:targetClass core:Agent ;
    sh:property [
        sh:path core:hasIntent ;
        sh:class core:Intent ;
    ] ;
    sh:property [
        sh:path core:hasCapability ;
        sh:class core:Capability ;
    ] ;
    sh:property [
        sh:path core:executesAction ;
        sh:class core:Action ;
    ] ;
    sh:property [
        sh:path core:performsTask ;
        sh:class core:Task ;
    ] .

core:DelegationShape
    a sh:NodeShape ;
    sh:targetClass core:Delegation ;
    sh:property [
        sh:path core:delegatedBy ;
        sh:class core:Agent ;
    ] ;
    sh:property [
        sh:path core:delegatesTo ;
        sh:class core:Agent ;
    ] ;
    sh:property [
        sh:path core:delegationScope ;
        sh:class core:Capability ;
    ] .

core:ActionShape
    a sh:NodeShape ;
    sh:targetClass core:Action ;
    sh:property [
        sh:path core:producesArtifact ;
        sh:class core:Artifact ;
    ] ;
    sh:property [
        sh:path core:recordedIn ;
        sh:class core:TraceEvent ;
    ] .

core:ExecutionContextShape
    a sh:NodeShape ;
    sh:targetClass core:ExecutionContext ;
    sh:property [
        sh:path core:contextOf ;
        sh:class core:Action ;
    ] .

core:TaskShape
    a sh:NodeShape ;
    sh:targetClass core:Task ;
    sh:property [
        sh:path core:requiresCapability ;
        sh:class core:Capability ;
    ] ;
    sh:property [
        sh:path core:hasSubtask ;
        sh:class core:Task ;
    ] .

core:TaskNodeShape
    a sh:NodeShape ;
    sh:targetClass core:TaskNode ;
    sh:property [
        sh:path core:hasDependency ;
        sh:class core:TaskNode ;
    ] .

core:TraceEventShape
    a sh:NodeShape ;
    sh:targetClass core:TraceEvent ;
    sh:property [
        sh:path core:timestamp ;
        sh:datatype xsd:dateTime ;
    ] .

core:ArtifactShape
    a sh:NodeShape ;
    sh:targetClass core:Artifact ;
    sh:property [
        sh:path core:description ;
        sh:datatype xsd:string ;
    ] .

#################################################################
# Ontology-level alignment checks (Core ↔ PROV / P-PLAN / EP-PLAN)
#################################################################

core:IntentAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:Intent ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue prov:Plan ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue pplan:Plan ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue epplan:Plan ;
        sh:minCount 1 ;
    ] .

core:ActionAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:Action ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue prov:Activity ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue pplan:Activity ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue epplan:Activity ;
        sh:minCount 1 ;
    ] .

core:ArtifactAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:Artifact ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue prov:Entity ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue pplan:Entity ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue epplan:Entity ;
        sh:minCount 1 ;
    ] .

core:TaskAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:Task ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue pplan:Step ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue epplan:Step ;
        sh:minCount 1 ;
    ] .

core:ProducesArtifactAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:producesArtifact ;
    sh:property [
        sh:path rdfs:subPropertyOf ;
        sh:hasValue prov:generated ;
        sh:minCount 1 ;
    ] .

core:RecordedInAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:recordedIn ;
    sh:property [
        sh:path rdfs:subPropertyOf ;
        sh:hasValue prov:generated ;
        sh:minCount 1 ;
    ] .

core:TimestampAlignmentShape
    a sh:NodeShape ;
    sh:targetNode core:timestamp ;
    sh:property [
        sh:path rdfs:subPropertyOf ;
        sh:hasValue prov:generatedAtTime ;
        sh:minCount 1 ;
    ] .
