@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ctx: <https://w3id.org/agent-ontology/execution-context#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix epplan: <https://w3id.org/ep-plan#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# -- Shape for ctx:ExecutionEnvironment --
ctx:ExecutionEnvironmentShape
    a sh:NodeShape ;
    sh:targetClass ctx:ExecutionEnvironment ;
    sh:property [
        sh:path ctx:envType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

#################################################################
# Ontology-level alignment checks (Execution Context ↔ PROV / EP-PLAN)
#################################################################

ctx:ExecutionEnvironmentAlignmentShape
    a sh:NodeShape ;
    sh:targetNode ctx:ExecutionEnvironment ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue prov:Entity ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue epplan:Entity ;
        sh:minCount 1 ;
    ] .
