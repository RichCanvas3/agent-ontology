{
  "@context": {
    "@vocab": "https://w3id.org/agent-ontology/agent#",
    "agent": "https://w3id.org/agent-ontology/agent#",
    "core": "https://w3id.org/agent-ontology/core#",
    "identity": "https://w3id.org/agent-ontology/identity#",
    "cap": "https://w3id.org/agent-ontology/capability#",
    "del": "https://w3id.org/agent-ontology/delegation#",
    "ai": "https://w3id.org/agent-ontology/ai-agent#",
    "eth": "https://w3id.org/agent-ontology/ethereum#",
    "ethid": "https://w3id.org/agent-ontology/ethereum-intent-delegation#",
    "eip7702": "https://w3id.org/agent-ontology/eip-7702#",
    "erc7710": "https://w3id.org/agent-ontology/erc-7710#",
    "erc4337": "https://w3id.org/agent-ontology/erc-4337#",
    "prov": "http://www.w3.org/ns/prov#",
    "pplan": "http://purl.org/net/p-plan#",
    "epplan": "https://w3id.org/ep-plan#",
    "did_ns": "https://www.w3.org/ns/did#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "economic": "/context/economic.jsonld",
    "lifecycle": "/context/lifecycle.jsonld",
    "contract": "/context/contract.jsonld",

    "id": "@id",
    "type": "@type",

    "Agent": "core:Agent",
    "AgentEntity": "core:AgentEntity",
    "Capability": "core:Capability",
    "Intent": "core:Intent",
    "Delegation": "core:Delegation",
    "Action": "core:Action",
    "ExecutionContext": "core:ExecutionContext",
    "TraceEvent": "core:TraceEvent",
    "Artifact": "core:Artifact",
    "AIAgent": "ai:AIAgent",
    "SoftwareAgent": "agent:SoftwareAgent",

    "did": {
      "@id": "did_ns:did",
      "@type": "@id"
    },
    "publicKey": {
      "@id": "did_ns:publicKey",
      "@type": "xsd:string"
    },
    "controller": {
      "@id": "did_ns:controller",
      "@type": "@id"
    },

    "hasIdentity": "agent:hasIdentity",
    "purpose_and_role": "agent:purposeAndRole",
    "operational_triggers_and_io": "agent:operationalTriggersAndIO",
    "system_integration_and_dependencies": "agent:systemIntegrationAndDependencies",
    "economic_interfaces": "agent:economicInterfaces",
    "identity_interfaces": "agent:identityInterfaces",
    "lifecycle_management": "agent:lifecycleManagement",
    "contractual_interfaces": "agent:contractualInterfaces",

    "hasIntent": {
      "@id": "core:hasIntent",
      "@type": "@id"
    },
    "hasCapability": {
      "@id": "core:hasCapability",
      "@type": "@id"
    },
    "executesAction": {
      "@id": "core:executesAction",
      "@type": "@id"
    },
    "wasAssociatedWith": {
      "@id": "core:wasAssociatedWith",
      "@type": "@id"
    },
    "producesArtifact": {
      "@id": "core:producesArtifact",
      "@type": "@id"
    },
    "recordedIn": {
      "@id": "core:recordedIn",
      "@type": "@id"
    },
    "contextOf": {
      "@id": "core:contextOf",
      "@type": "@id"
    },

    "delegatedBy": {
      "@id": "del:delegatedBy",
      "@type": "@id"
    },
    "delegatesTo": {
      "@id": "del:delegatesTo",
      "@type": "@id"
    },
    "actedOnBehalfOf": {
      "@id": "del:actedOnBehalfOf",
      "@type": "@id"
    },
    "delegationScope": {
      "@id": "del:delegationScope",
      "@type": "@id"
    },

    "description": "core:description"
  }
}
